@keyframes rotate
  from
    background-position -3000px
  to
    background-position 0px
.type-tab-line
  position absolute
  bottom 0
  left 0
  width 100%
  height 1px
  background var(--text-dark)
  display none
.type-tab-txt
  position relative
  display inline-block

.type-tab
  display inline-block
  vertical-align middle
  line-height 30px
  padding 0 20px 0 0
  margin-right 0px
  font-size 14px
  cursor pointer
  &:hover
  &.active
    color var(--text-light)
  &.active
    .type-tab-line
      display inline-block

.is-transporting
  .type-tab.sftp
    .type-tab-line
      display inline-block
      background linear-gradient(to right, var(--success) 0%, var(--main) 25%, var(--error) 50%, var(--primary) 75%, var(--success) 100%)
      animation: rotate 60s infinite linear
.disable-ssh
  .type-tab.ssh
    display none
.spliter
  color var(--text)
  &:hover
    color var(--text-light)

.sessions
  position absolute
  background var(--main)
.session-wrap
  display none
  position absolute
  overflow hidden
  z-index 3
  padding-top 36px
  box-shadow 0px 0px 1px 1px var(--main-darker)
  &.session-batch-active
    display block
  &:has(.ssh-sftp-split)
    padding-top 0

.term-sftp-box
  height 100%
.session-log-bar
  flex-shrink 0
  height 28px
  line-height 28px
  padding 0 12px
  display flex
  align-items center
  gap 8px
  font-size 12px
  color var(--success)
  background var(--main-lighter)
  border-bottom 1px solid var(--success)
  overflow hidden
  .session-log-bar-path
    flex 1
    min-width 0
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    a
      color var(--success)
.web-session-wrap
  height 100%
  background var(--main)
  overflow hidden
  display flex
  flex-direction column
.web-session-content
  flex 1
  min-height 0
  overflow hidden
.session-v-info
  line-height 30px
.vnc-scroll-wrapper
  position relative
  background var(--main)
  z-index 299
  &::-webkit-scrollbar
    width 16px
    height 16px
    background var(--main-darker)
  &::-webkit-scrollbar-track
    background var(--main-darker)
    box-shadow inset 0 0 5px var(--main-darker)
  &::-webkit-scrollbar-thumb
    background var(--primary)
    border-radius 0
  &::-webkit-scrollbar-corner
    background var(--main-darker)

.not-split-view > .ant-splitter-bar .ant-splitter-bar-dragger
  display none
.ssh-sftp-split
  .sftp-panel
    padding 4px
  .sftp-panel-title
    padding 4px 8px
    font-size 12px
    line-height 22px
    border-bottom 1px solid var(--border)

.sess-icon
  margin-right 10px
  &.active
    color var(--warn)

.wrap-toggle-icon
.split-view-toggle
  &.active
    color var(--success)