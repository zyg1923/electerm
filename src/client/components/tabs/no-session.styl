.no-sessions
  background var(--main)
  text-align center
  // stack buttons / logo / history; the history flexes to fill the remaining
  // height, so the layout adapts to logo size and button wrapping without any
  // fixed pixel offsets.
  display flex
  flex-direction column
  position absolute
  top 36px
  left 0
  right 0
  bottom 0
  padding 50px 0
  z-index 11
.no-session-btns
  flex-shrink 0
  display flex
  flex-wrap wrap
  justify-content center
  align-items center
  gap 8px
  padding-bottom 8px
.no-session-logo
  flex-shrink 0
  padding 32px 0
.no-session-history
  flex 1
  min-height 120px
  display flex
  flex-direction column
  overflow hidden
  width 100%
  max-width 480px
  margin 0 auto
  text-align left
.no-session-history-title
  flex-shrink 0
  font-size 14px
  font-weight 600
  color var(--text)
  opacity 0.85
  padding 8px 16px 4px
.no-session-history
  .sidebar-panel-history
    // override the global sidebar absolute positioning (top:112px) so the
    // history fills this flex item instead.
    position static !important
    top auto !important
    bottom auto !important
    left auto !important
    right auto !important
    flex 1
    min-height 0
    width 100%
    .pd2x
      width 100%
      margin 0 auto
    .history-body
      min-height 40px
.is-mobile
  .no-sessions
    padding 20px 0
  .no-session-logo
    padding 8px 0
  .no-session-history
    max-width none
    .sidebar-panel-history
      .pd2x
        width auto
        max-width 400px
