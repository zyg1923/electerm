.ops-center-modal
  .ops-preview-pre
    max-height 240px
    overflow auto
    background rgba(0, 0, 0, 0.04)
    padding 8px
    font-size 12px
  .ops-live-out pre
    max-height 180px
    overflow auto
    background rgba(0, 0, 0, 0.04)
    padding 8px
    font-size 12px
  .ops-tab-select
    max-height 160px
    overflow auto
    border 1px solid rgba(0, 0, 0, 0.06)
    padding 8px
    border-radius 4px
  .ops-panel
    min-height 320px
  .ops-log-view
    max-height 360px
    min-height 160px
    overflow auto
    white-space pre-wrap
    word-break break-word
    background rgba(0, 0, 0, 0.04)
    padding 8px
    font-size 12px
    font-family ui-monospace, monospace
    mark
      background rgba(250, 173, 20, 0.45)
      color inherit
      padding 0 1px
  .ops-docker-detail
    line-height 1.7
    word-break break-all
