.transfer-history-body
  display flex
  flex-direction column
  min-height 0
  height 100%
  box-sizing border-box

.transfer-path-link
  color var(--colorPrimary, #1677ff)
  cursor pointer
  &:hover
    text-decoration underline

.transfer-archive-tag
  opacity 0.85
  font-size 12px

.transfer-archive-note
  opacity 0.65
  font-size 12px
  margin-left 2px

.setting-wrap .transfer-history-body
  padding-top 56px

.transfer-history-toolbar
  display flex
  align-items center
  justify-content space-between
  flex-shrink 0
  margin-bottom 8px

.transfer-history-total
  opacity 0.65
  font-size 12px

.table-scroll-wrap
  flex 1
  min-height 120px
  width 100%
  overflow auto

.transfer-history-pager
  flex-shrink 0
  display flex
  justify-content flex-end
  padding 10px 0 0
  border-top 1px solid var(--main-darker, rgba(255, 255, 255, 0.08))
  margin-top 8px

  .ant-pagination
    margin 0 !important
